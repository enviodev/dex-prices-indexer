# To create or update a token visit https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# RPC URLs, one per chain in config.yaml. These are used by the
# getTokenMetadata effect (name, symbol, decimals), not by the indexer's event
# ingestion, which goes through HyperSync.
#
# Every chain falls back to a public drpc.org endpoint if unset
# (src/utils/tokenMetadata.ts). Those fallbacks will rate-limit on a cold
# metadata cache across 18 chains, so set real endpoints before a full sync.
# See DEPLOY.md.
ENVIO_MAINNET_RPC_URL=""
ENVIO_ARBITRUM_RPC_URL=""
ENVIO_OPTIMISM_RPC_URL=""
ENVIO_BASE_RPC_URL=""
ENVIO_POLYGON_RPC_URL=""
ENVIO_AVALANCHE_RPC_URL=""
ENVIO_BSC_RPC_URL=""
ENVIO_BLAST_RPC_URL=""
ENVIO_ZORA_RPC_URL=""
ENVIO_SONEIUM_RPC_URL=""   # see the note in src/utils/tokenMetadata.ts
ENVIO_UNICHAIN_RPC_URL=""
ENVIO_INK_RPC_URL=""
ENVIO_WORLDCHAIN_RPC_URL=""
ENVIO_MONAD_RPC_URL=""
ENVIO_LINEA_RPC_URL=""
ENVIO_CELO_RPC_URL=""
ENVIO_MEGAETH_RPC_URL=""
ENVIO_ROBINHOOD_RPC_URL=""
